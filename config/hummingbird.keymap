#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF_L 0
#define MISC_L 1

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace
&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <225>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_backslash {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp NON_US_BACKSLASH>;
        };
        combo_v {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&kp V>;
        };

        combo_n {
            timeout-ms = <50>;
            key-positions = <23 24>;
            bindings = <&kp N>;
        };

        combo_slash {
            timeout-ms = <50>;
            key-positions = <24 25>;
            bindings = <&kp SLASH>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            //  Q          W          E           R               T            Y                U              I           O          P
                &kp Q      &kp W      &kp E       &kp R           &kp T        &kp Y            &kp U          &kp I       &kp O      &kp P
            //  A          S          D           F               G            H                J              K           L          ; (shift :)
                &kp A      &kp S      &kp D       &kp F           &kp G        &kp H            &kp J          &kp K       &kp L      &kp SEMI
            //             Z          X           C                                             M              ,          .
                           &kp Z      &kp X       &kp C                                         &kp M          &kp COMMA  &kp DOT
            //                                    alt       space           space    alg_gr
                                                  &kp LALT  &lt MISC_L SPACE       &kp SPACE  &kp RALT
            >;
        };
        misc_layer {
            display-name = "Misc";
            bindings = <
                &kp C_BRI_UP   &msc SCRL_LEFT &mmv MOVE_UP   &msc SCRL_RIGHT &msc SCRL_UP       &kp F1            &kp F7 &kp F8  &kp F9 &kp F11
                &kp C_BRI_DN   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DOWN     &kp PRINTSCREEN   &kp F4 &kp F5  &kp F6 &kp F10
                            &mkp RCLK  &mkp MCLK   &mkp LCLK                                                 &kp F1 &kp F2  &kp F3
                                                      &trans          &trans           &trans        &trans
            >;
        };

    };
};
